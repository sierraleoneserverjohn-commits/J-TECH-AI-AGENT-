# ==========================================
# JEXA Backend Environment Configuration
# ==========================================
PORT=3000
NODE_ENV=production

# 1. API Gateway & Security
# In production, ACCESS_TOKEN is mandatory
ACCESS_TOKEN=""
# Must match exact origin (e.g. https://your-username.github.io) in production
ALLOWED_ORIGIN=""

# 2. Model Gateway Providers (Model names configured exclusively via ENV)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

GEMINI_API_KEY=""
# Recommended Chat models: gemini-3.8-flash (Recommended), gemini-3.5-flash-lite (Fast/Lite)
# Warning: gemini-2.0-flash and gemini-1.5-* are deprecated/retiring
GEMINI_MODEL="gemini-3.8-flash"
# Recommended Live Voice models: gemini-3.8-live (Recommended), gemini-3.1-flash-live-preview (Fallback)
GEMINI_LIVE_MODEL="gemini-3.8-live"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# 3. Daily Request Caps per Provider (Fault tolerance & rate protection)
DAILY_CAP_GROQ=14400
DAILY_CAP_GEMINI=1500
DAILY_CAP_OPENROUTER=500

# 4. Token & Generation Limits
MAX_OUTPUT_TOKENS=400

# 5. External Tool Integrations
TAVILY_API_KEY=""
GITHUB_TOKEN=""

# 6. Context & Working Memory (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 7. Long-Term Memory (Supabase)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
