# ==========================================
# JEXA Backend Environment Configuration
# ==========================================
PORT=3000
NODE_ENV=production

# 1. API Gateway & Security
ACCESS_TOKEN="your_secure_bearer_token_here"
ALLOWED_ORIGIN="*"

# 2. Model Gateway Providers (Model names configured exclusively via ENV)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_LIVE_MODEL="gemini-3.8-live"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# 3. Daily Request Caps per Provider (Fault tolerance & cost guard)
DAILY_CAP_GROQ=14400
DAILY_CAP_GEMINI=1500
DAILY_CAP_OPENROUTER=500

# 4. Token & Generation Limits
MAX_OUTPUT_TOKENS=400

# 5. External Tool Integrations
TAVILY_API_KEY=""
GITHUB_TOKEN=""

# 6. Context & Working Memory (Upstash Redis REST)
# Leave blank to automatically use in-memory fallback
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 7. Long-Term Memory (Supabase)
# Leave blank to disable or use local in-memory fallback
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
